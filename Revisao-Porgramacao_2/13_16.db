INSERT INTO emprestimos (livro_id, usuario_id, data_emprestimo) VALUES (2, 1, '2026-03-01');

SELECT * FROM livros;
SELECT l.titulo, a.nome AS autor FROM livros l JOIN autores a ON l.autor_id = a.id;
SELECT l.titulo FROM livros l JOIN autores a ON l.autor_id = a.id WHERE a.nome = 'Machado de Assis';
SELECT * FROM livros ORDER BY titulo ASC;
SELECT * FROM livros WHERE disponivel = TRUE;

UPDATE usuarios SET nome = 'Ana Clara Silva' WHERE id = 1;
UPDATE livros SET disponivel = FALSE WHERE id = 1;
UPDATE emprestimos SET data_devolucao = '2026-03-20' WHERE id = 1;

DELETE FROM emprestimos WHERE id = 1;
DELETE FROM usuarios WHERE id = 3;
DELETE FROM livros WHERE id = 5;

SELECT u.nome, l.titulo 
FROM emprestimos e 
JOIN usuarios u ON e.usuario_id = u.id 
JOIN livros l ON e.livro_id = l.id;

SELECT * FROM emprestimos;

SELECT * FROM emprestimos WHERE data_devolucao IS NULL;

SELECT u.nome, COUNT(e.id) AS total_emprestimos 
FROM usuarios u 
LEFT JOIN emprestimos e ON u.id = e.usuario_id 
GROUP BY u.id, u.nome;

-- 5. Livros que nunca foram emprestados
SELECT l.* 
FROM livros l 
LEFT JOIN emprestimos e ON l.id = e.livro_id 
WHERE e.id IS NULL;